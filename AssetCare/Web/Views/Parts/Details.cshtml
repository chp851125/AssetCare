@model PartDetail
@{
    ViewData["Title"] = $"{Model.PartNo} {Model.Name}";
    var isManager = User.IsManager();
}
<a class="d-inline-block mb-2" asp-action="Index"><i class="bi bi-chevron-left"></i> 零件庫存</a>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <div class="text-secondary">@Model.PartNo</div>
        <h1 class="h4 mb-1">@Model.Name</h1>
        @if (Model.IsLowStock) { <span class="badge text-bg-danger">低於安全量</span> }
        @if (!Model.IsActive) { <span class="badge text-bg-secondary">停用</span> }
    </div>
    @if (isManager)
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> 編輯</a>
    }
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <section class="card mb-3">
            <div class="card-body">
                <div class="text-secondary">目前庫存</div>
                <div class="stat-value @(Model.IsLowStock ? "text-danger" : "")">@Model.StockQuantity <span class="fs-5">@Model.Unit</span></div>
                <dl class="row detail-list mb-0">
                    <dt class="col-4">安全庫存</dt><dd class="col-8">@Model.SafetyStock @Model.Unit</dd>
                    <dt class="col-4">規格</dt><dd class="col-8">@(Model.Spec ?? "—")</dd>
                    <dt class="col-4">單價</dt><dd class="col-8">NT$ @Model.UnitCost.ToString("N0")</dd>
                    <dt class="col-4">存放位置</dt><dd class="col-8">@(Model.StorageLocation ?? "—")</dd>
                    <dt class="col-4">廠商</dt>
                    <dd class="col-8">@(Model.VendorName ?? "—") @if (Model.VendorPhone is not null) { <a class="d-block" href="tel:@Model.VendorPhone">@Model.VendorPhone</a> }</dd>
                </dl>
            </div>
        </section>

        @if (Model.IsActive)
        {
            <section class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">領用</h2>
                    @if (Model.IssueTargets.Count == 0)
                    {
                        <p class="text-secondary mb-0">目前沒有您可領料的工單（需為處理中或待料中）。</p>
                    }
                    else
                    {
                        <form asp-action="Issue" asp-route-id="@Model.Id" method="post" class="row g-2">
                            <div class="col-12">
                                <select class="form-select" name="workOrder" required aria-label="工單">
                                    <option value="">選擇工單</option>
                                    @foreach (var target in Model.IssueTargets)
                                    {
                                        <option value="@target.Id|@target.Version">@target.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-5"><input type="number" class="form-control" name="quantity" min="1" max="@Model.StockQuantity" step="1" value="1" required inputmode="numeric" aria-label="數量" /></div>
                            <div class="col-7 d-grid"><button type="submit" class="btn btn-primary" disabled="@(Model.StockQuantity == 0)">領用</button></div>
                        </form>
                    }
                </div>
            </section>
        }

        @if (isManager)
        {
            @if (Model.IsActive)
            {
                <section class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5">入庫</h2>
                        <form asp-action="StockIn" asp-route-id="@Model.Id" method="post" class="row g-2">
                            <input type="hidden" name="version" value="@Model.Version" />
                            <div class="col-6">
                                <label class="form-label small mb-1" for="quantity-in">數量</label>
                                <input type="number" class="form-control" id="quantity-in" name="quantity" min="1" step="1" required inputmode="numeric" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-1" for="unitCost">進貨單價</label>
                                <input type="number" class="form-control" id="unitCost" name="unitCost" min="0" step="0.01" value="@Model.UnitCost" required inputmode="decimal" />
                            </div>
                            <div class="col-12"><input type="text" class="form-control" name="note" maxlength="200" placeholder="備註（採購單號等，選填）" aria-label="備註" /></div>
                            <div class="col-12 d-grid"><button type="submit" class="btn btn-outline-primary">確認入庫</button></div>
                        </form>
                    </div>
                </section>
            }
            <section class="card">
                <div class="card-body">
                    <h2 class="h5">盤點調整</h2>
                    <form asp-action="Adjust" asp-route-id="@Model.Id" method="post" class="row g-2" data-confirm="確定要依盤點結果調整庫存？">
                        <input type="hidden" name="version" value="@Model.Version" />
                        <div class="col-12">
                            <label class="form-label small mb-1" for="actualQuantity">實際數量</label>
                            <input type="number" class="form-control" id="actualQuantity" name="actualQuantity" min="0" step="1" required inputmode="numeric" />
                        </div>
                        <div class="col-12"><input type="text" class="form-control" name="note" maxlength="200" required placeholder="調整原因" aria-label="調整原因" /></div>
                        <div class="col-12 d-grid"><button type="submit" class="btn btn-outline-secondary">調整庫存</button></div>
                    </form>
                </div>
            </section>
        }
    </div>

    <div class="col-lg-7">
        <section class="card">
            <div class="card-body">
                <h2 class="h5">異動紀錄</h2>
                @if (Model.Transactions.Count == 0)
                {
                    <p class="text-secondary mb-0">尚無異動。</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var t in Model.Transactions)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between gap-2">
                                <div class="min-w-0">
                                    <div class="small text-secondary">@Clock.Format(t.OccurredAt)・@t.OperatorName</div>
                                    <div>
                                        @t.Type.Label()
                                        @if (t.WorkOrderId is { } orderId) { <a class="ms-1" asp-controller="WorkOrders" asp-action="Details" asp-route-id="@orderId">@t.OrderNo</a> }
                                    </div>
                                    @if (t.Note is not null) { <div class="small">@t.Note</div> }
                                </div>
                                <div class="text-end text-nowrap">
                                    <strong class="@(t.Quantity < 0 ? "text-danger" : "text-success")">@t.Quantity.ToString("+#;-#;0")</strong>
                                    <div class="small text-secondary">結餘 @t.BalanceAfter</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
</div>
