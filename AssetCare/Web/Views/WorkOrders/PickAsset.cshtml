@model ReportPickViewModel
@{ ViewData["Title"] = "我要報修"; }
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h4 mb-3">我要報修</h1>
        <a class="btn btn-primary btn-lg w-100 mb-3" asp-controller="Scan" asp-action="Index">
            <i class="bi bi-qr-code-scan"></i> 掃描設備 QR Code
        </a>
        <div class="card">
            <div class="card-body">
                <form method="get" asp-action="Create">
                    <label class="form-label" for="assetId">或從清單選擇資產</label>
                    <select class="form-select form-select-lg mb-3" id="assetId" name="assetId" asp-items="Model.Assets.ToSelectList()" required>
                        <option value="">請選擇</option>
                    </select>
                    <button type="submit" class="btn btn-outline-primary btn-lg w-100">下一步</button>
                </form>
            </div>
        </div>
    </div>
</div>
