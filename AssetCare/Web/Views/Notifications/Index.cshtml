@model NotificationIndexViewModel
@{ ViewData["Title"] = "通知"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">通知</h1>
    @if (Model.UnreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-check2-all"></i> 全部已讀</button>
        </form>
    }
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(Model.Query.UnreadOnly ? "" : "active")" asp-action="Index">全部</a></li>
    <li class="nav-item"><a class="nav-link @(Model.Query.UnreadOnly ? "active" : "")" asp-action="Index" asp-route-unreadOnly="true">未讀（@Model.UnreadCount）</a></li>
</ul>

@if (Model.Result.Total == 0)
{
    <div class="empty-state">
        <i class="bi bi-bell"></i>
        <p class="text-secondary">@(Model.Query.UnreadOnly ? "沒有未讀通知。" : "目前沒有通知。")</p>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model.Result.Items)
        {
            <form asp-action="Open" asp-route-id="@n.Id" method="post">
                <button type="submit" class="list-group-item list-group-item-action notification-item @(n.IsRead ? "" : "unread")">
                    <span class="d-flex justify-content-between gap-2">
                        <span class="small text-secondary">@n.Type.Label()・@Clock.Format(n.CreatedAt)</span>
                        @if (!n.IsRead) { <span class="badge text-bg-danger align-self-start">未讀</span> }
                    </span>
                    <span class="d-block fw-semibold">@n.Title</span>
                    <span class="d-block small">@n.Message</span>
                </button>
            </form>
        }
    </div>
}
<partial name="_Pager" model="PagerViewModel.From(Model.Result)" />
