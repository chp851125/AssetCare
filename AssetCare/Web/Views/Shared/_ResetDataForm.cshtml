@model string
<form asp-controller="Admin" asp-action="ResetData" method="post" class="d-inline"
      data-confirm="目前所有資料（含上傳的附件）將被清除並還原為範例資料，此操作無法復原。完成後需要重新登入。"
      data-confirm-title="重置為範例資料">
    <button type="submit" class="@Model" title="重置為範例資料" aria-label="重置為範例資料">
        <i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-sm-inline">重置為範例資料</span>
    </button>
</form>
