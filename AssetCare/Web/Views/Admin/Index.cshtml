@{ ViewData["Title"] = "系統管理"; }
<h1 class="h4 mb-3">系統管理</h1>
<div class="list-group mb-3">
    <a class="list-group-item list-group-item-action py-3" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-2"></i>使用者管理</a>
    <a class="list-group-item list-group-item-action py-3" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders me-2"></i>SLA 與系統參數</a>
    <a class="list-group-item list-group-item-action py-3" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text me-2"></i>稽核紀錄</a>
</div>
@if (DevTools.IsDevelopment)
{
    <div class="card border-danger-subtle">
        <div class="card-body">
            <h2 class="h5">重置為範例資料</h2>
            <p class="text-secondary">清除目前所有資料並從範例資料重新建立（僅開發環境提供）。</p>
            <partial name="_ResetDataForm" model='"btn btn-danger"' />
        </div>
    </div>
}
