@model IReadOnlyList<CategoryListItem>
@{ ViewData["Title"] = "資產類別"; }
<a class="d-inline-block mb-2" asp-controller="Assets" asp-action="Index"><i class="bi bi-chevron-left"></i> 資產清單</a>
<div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">資產類別</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> 新增類別</a>
</div>

<ul class="list-group">
    @foreach (var c in Model)
    {
        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <div>
                    <span class="badge text-bg-light border">@c.Code</span>
                    <strong>@c.Name</strong>
                    @if (!c.IsActive) { <span class="badge text-bg-secondary">停用</span> }
                </div>
                <div class="small text-secondary">耐用 @c.DefaultUsefulLifeYears 年・@c.AssetCount 筆資產@(c.Description is null ? "" : $"・{c.Description}")</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i> 編輯</a>
                @if (c.AssetCount == 0)
                {
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" data-confirm="確定要刪除類別「@c.Name」？">
                        <input type="hidden" name="version" value="@c.Version" />
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i> 刪除</button>
                    </form>
                }
            </div>
        </li>
    }
</ul>
