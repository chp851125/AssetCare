@model HomeSummary
@{ ViewData["Title"] = "首頁"; }
<div class="mb-3">
    <h1 class="h4 mb-1">@User.FindFirst(AppClaimTypes.DisplayName)?.Value，您好</h1>
    <div class="text-secondary small">@Clock.Format(Clock.UtcNow, "yyyy/MM/dd（dddd） HH:mm")</div>
</div>
<div class="row g-3">
    @foreach (var card in Model.Cards)
    {
        <div class="col-6 col-md-4 col-xl">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <i class="bi @card.Icon text-@card.Tone"></i>
                    <div class="stat-value">@card.Value</div>
                    <div class="text-secondary">@card.Title</div>
                </div>
            </div>
        </div>
    }
</div>

<h2 class="h6 text-secondary mt-4">常用功能</h2>
<div class="list-group">
    <a class="list-group-item list-group-item-action py-3" asp-controller="WorkOrders" asp-action="Create"><i class="bi bi-tools me-2"></i>我要報修</a>
    <a class="list-group-item list-group-item-action py-3" asp-controller="WorkOrders" asp-action="Index"><i class="bi bi-clipboard-check me-2"></i>工單清單</a>
    <a class="list-group-item list-group-item-action py-3" asp-controller="Assets" asp-action="Index"><i class="bi bi-pc-display me-2"></i>資產清單</a>
    @if (User.IsStaff())
    {
        <a class="list-group-item list-group-item-action py-3" asp-controller="Parts" asp-action="Index"><i class="bi bi-box-seam me-2"></i>零件庫存</a>
    }
    @if (User.IsManager())
    {
        <a class="list-group-item list-group-item-action py-3" asp-controller="Vendors" asp-action="Index"><i class="bi bi-building me-2"></i>廠商</a>
    }
    @if (User.IsManager())
    {
        <a class="list-group-item list-group-item-action py-3" asp-controller="Assets" asp-action="Create"><i class="bi bi-plus-square me-2"></i>新增資產</a>
    }
    @if (User.IsInRole(Roles.Admin))
    {
        <a class="list-group-item list-group-item-action py-3" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-2"></i>使用者管理</a>
    }
</div>
