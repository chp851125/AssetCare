@model UserIndexViewModel
@{
    ViewData["Title"] = "使用者管理";
    var q = Model.Query;
}
<a class="d-inline-block mb-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-chevron-left"></i> 系統管理</a>
<div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">使用者管理</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> 新增使用者</a>
</div>

<form method="get" asp-action="Index" class="card mb-3">
    <div class="card-body row g-2">
        <div class="col-12 col-lg-4">
            <input type="search" class="form-control" name="Keyword" value="@q.Keyword" placeholder="帳號、姓名、Email" aria-label="關鍵字" />
        </div>
        <div class="col-4 col-lg-2">
            <select class="form-select" name="Role" aria-label="角色">
                <option value="">全部角色</option>
                @foreach (var r in Enum.GetValues<UserRole>())
                {
                    <option value="@r" selected="@(q.Role == r)">@r.Label()</option>
                }
            </select>
        </div>
        <div class="col-4 col-lg-2">
            <select class="form-select" name="DepartmentId" asp-for="Query.DepartmentId" asp-items="Model.Departments.ToSelectList()" aria-label="部門">
                <option value="">全部部門</option>
            </select>
        </div>
        <div class="col-4 col-lg-2">
            <select class="form-select" name="IsActive" aria-label="狀態">
                <option value="">全部狀態</option>
                <option value="true" selected="@(q.IsActive == true)">啟用</option>
                <option value="false" selected="@(q.IsActive == false)">停用</option>
            </select>
        </div>
        <div class="col-12 col-lg-2 d-grid">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> 搜尋</button>
        </div>
    </div>
</form>

@if (Model.Result.Total == 0)
{
    <div class="empty-state"><i class="bi bi-people"></i><p class="text-secondary">沒有符合條件的使用者。</p></div>
}
else
{
    <div class="d-lg-none list-group">
        @foreach (var u in Model.Result.Items)
        {
            <a class="list-group-item list-group-item-action" asp-action="Edit" asp-route-id="@u.Id">
                <div class="d-flex justify-content-between gap-2">
                    <strong>@u.DisplayName</strong>
                    <span>
                        @if (u.IsLocked) { <span class="badge text-bg-warning">鎖定中</span> }
                        <span class="badge @(u.IsActive ? "text-bg-success" : "text-bg-secondary")">@(u.IsActive ? "啟用" : "停用")</span>
                    </span>
                </div>
                <div class="small text-secondary">@u.UserName・@u.Role.Label()・@(u.DepartmentName ?? "無部門")</div>
            </a>
        }
    </div>
    <div class="card d-none d-lg-block">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">帳號</th><th scope="col">姓名</th><th scope="col">角色</th><th scope="col">部門</th>
                    <th scope="col">Email</th><th scope="col">狀態</th><th scope="col">上次登入</th>
                    <th scope="col"><span class="visually-hidden">操作</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Result.Items)
                {
                    <tr>
                        <td>@u.UserName</td>
                        <td>@u.DisplayName</td>
                        <td>@u.Role.Label()</td>
                        <td>@(u.DepartmentName ?? "—")</td>
                        <td class="text-break">@u.Email</td>
                        <td class="text-nowrap">
                            <span class="badge @(u.IsActive ? "text-bg-success" : "text-bg-secondary")">@(u.IsActive ? "啟用" : "停用")</span>
                            @if (u.IsLocked) { <span class="badge text-bg-warning">鎖定中</span> }
                        </td>
                        <td class="text-nowrap">@Clock.Format(u.LastLoginAt)</td>
                        <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">管理</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<partial name="_Pager" model="PagerViewModel.From(Model.Result)" />
