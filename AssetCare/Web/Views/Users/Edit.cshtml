@model UserEditViewModel
@{
    var u = Model.User;
    ViewData["Title"] = $"管理使用者 {u.UserName}";
}
<a class="d-inline-block mb-2" asp-action="Index"><i class="bi bi-chevron-left"></i> 使用者管理</a>
<h1 class="h4 mb-1">@u.UserName</h1>
<p>
    <span class="badge @(u.IsActive ? "text-bg-success" : "text-bg-secondary")">@(u.IsActive ? "啟用" : "停用")</span>
    @if (u.LockedUntil is not null) { <span class="badge text-bg-warning">鎖定至 @Clock.Format(u.LockedUntil)</span> }
</p>

<form asp-action="Edit" asp-route-id="@u.Id" method="post" class="card mb-3" novalidate>
    <div class="card-body row g-3">
        <h2 class="h5 mb-0">基本資料</h2>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Version" />
        <partial name="_ProfileFields" model="Model" />
        <div class="col-md-4">
            <label asp-for="Role" class="form-label"></label>
            @if (u.IsSelf)
            {
                <input type="hidden" asp-for="Role" />
                <input class="form-control" value="@Model.Role.Label()" disabled />
                <div class="form-text">不可變更自己的角色。</div>
            }
            else
            {
                <select asp-for="Role" class="form-select">
                    @foreach (var r in Enum.GetValues<UserRole>())
                    {
                        <option value="@r">@r.Label()</option>
                    }
                </select>
                <div class="form-text">變更角色後該使用者需重新登入。</div>
            }
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary btn-lg">儲存</button>
        </div>
    </div>
</form>

<form asp-action="ResetPassword" asp-route-id="@u.Id" method="post" class="card mb-3" autocomplete="off"
      data-confirm="確定要重設 @u.UserName 的密碼？該帳號目前的登入會立即失效。">
    <div class="card-body row g-3">
        <h2 class="h5 mb-0">重設密碼</h2>
        <input type="hidden" name="Version" value="@u.Version" />
        <div class="col-md-4">
            <label class="form-label" for="NewPassword">新密碼</label>
            <input type="password" class="form-control" id="NewPassword" name="NewPassword" required minlength="@Model.PasswordMinLength" maxlength="100" autocomplete="new-password" />
            <div class="form-text">至少 @Model.PasswordMinLength 個字元，含英文字母與數字，不可包含帳號。</div>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="ConfirmPassword">確認新密碼</label>
            <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" required maxlength="100" autocomplete="new-password" />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-outline-primary">重設密碼</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <h2 class="h5 mb-0 me-auto">帳號狀態</h2>
        @if (u.LockedUntil is not null)
        {
            <form asp-action="Unlock" asp-route-id="@u.Id" method="post">
                <input type="hidden" name="version" value="@u.Version" />
                <button type="submit" class="btn btn-outline-warning"><i class="bi bi-unlock"></i> 解除鎖定</button>
            </form>
        }
        @if (u.IsSelf)
        {
            <span class="text-secondary">不可停用自己的帳號。</span>
        }
        else
        {
            <form asp-action="SetActive" asp-route-id="@u.Id" method="post"
                  data-confirm="@(u.IsActive ? $"確定要停用 {u.UserName}？停用後立即無法使用系統。" : $"確定要啟用 {u.UserName}？")">
                <input type="hidden" name="version" value="@u.Version" />
                <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                    @(u.IsActive ? "停用帳號" : "啟用帳號")
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
