@model IReadOnlyList<LocationNode>
@{ ViewData["Title"] = "地點"; }
<a class="d-inline-block mb-2" asp-controller="Assets" asp-action="Index"><i class="bi bi-chevron-left"></i> 資產清單</a>
<div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">地點</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> 新增地點</a>
</div>

<ul class="list-group">
    @foreach (var l in Model)
    {
        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="location-depth-@Math.Min(l.Depth, 4)">
                <div>
                    @if (l.Depth > 0) { <i class="bi bi-arrow-return-right text-secondary me-1"></i> }
                    <strong>@l.Name</strong>
                    @if (!l.IsActive) { <span class="badge text-bg-secondary">停用</span> }
                </div>
                <div class="small text-secondary">@l.Code・<a asp-controller="Assets" asp-action="Index" asp-route-LocationId="@l.Id">本層 @l.AssetCount 筆資產</a></div>
            </div>
            <div class="d-flex gap-2">
                @if (l.IsActive)
                {
                    <a class="btn btn-outline-secondary" asp-action="Create" asp-route-parentId="@l.Id" title="新增下層地點"><i class="bi bi-plus-lg"></i><span class="visually-hidden">新增下層地點</span></a>
                }
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@l.Id"><i class="bi bi-pencil"></i> 編輯</a>
                @if (l.CanDelete)
                {
                    <form asp-action="Delete" asp-route-id="@l.Id" method="post" data-confirm="確定要刪除地點「@l.Name」？">
                        <input type="hidden" name="version" value="@l.Version" />
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i><span class="visually-hidden">刪除</span></button>
                    </form>
                }
            </div>
        </li>
    }
</ul>
